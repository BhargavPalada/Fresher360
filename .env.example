# Copy this to backend/.env and fill in real values
# NEVER commit the actual .env file

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/fresher360

# ─── JWT Access Token ────────────────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# ─── JWT Refresh Token ───────────────────────────────────────────────────────
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_SECURE_RANDOM_STRING
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

# ─── Seed Users ──────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@fresher360.com
SEED_ADMIN_PASSWORD=Admin@1234!
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=User

SEED_USER_EMAIL=user@fresher360.com
SEED_USER_PASSWORD=User@1234!
SEED_USER_FIRST_NAME=John
SEED_USER_LAST_NAME=Doe

# ─── Email / SMTP ─────────────────────────────────────────────────────────────
# Used to send OTP emails for the forgot-password flow.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@fresher360.com
MAIL_FROM_NAME=Fresher360
MAIL_STARTTLS=True
MAIL_SSL_TLS=False
USE_CREDENTIALS=True
VALIDATE_CERTS=False

# ─── OTP / Password-reset ─────────────────────────────────────────────────────
# Minimum 32 characters — generate with: python -c "import secrets; print(secrets.token_hex(32))"
OTP_HMAC_SECRET=REPLACE_WITH_SECURE_RANDOM_OTP_HMAC_KEY_MIN_32_CHARS
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_COUNT=3
OTP_RATE_LIMIT_WINDOW_MINUTES=10
RESET_TOKEN_EXPIRE_MINUTES=15

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
