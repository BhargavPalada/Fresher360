# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/fresher360

# ─── JWT Access Token ────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# ─── JWT Refresh Token ───────────────────────────────────────────────────────
# Use a DIFFERENT secret from JWT_SECRET
JWT_REFRESH_SECRET=CHANGE_THIS_REFRESH_SECRET_IN_PRODUCTION
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CORS ────────────────────────────────────────────────────────────────────
# In production, set to your Vercel URL e.g. ["https://fresher360.vercel.app"]
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
# Optional regex to allow Vercel preview deploys, e.g. ^https:\/\/.*\.vercel\.app$
CORS_ALLOWED_ORIGIN_REGEX=

# ─── Cookie Security ──────────────────────────────────────────────────────────
# Set COOKIE_SECURE=true and COOKIE_SAMESITE=none if frontend and backend are on different domains
# In development, leave blank or false with lax
COOKIE_SECURE=
COOKIE_SAMESITE=lax

# ─── Seed Users ──────────────────────────────────────────────────────────────
# Used by scripts/seed.py — passwords hashed before insertion
SEED_ADMIN_EMAIL=admin@fresher360.com
SEED_ADMIN_PASSWORD=Admin@1234!
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=User

SEED_USER_EMAIL=user@fresher360.com
SEED_USER_PASSWORD=User@1234!
SEED_USER_FIRST_NAME=John
SEED_USER_LAST_NAME=Doe

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
